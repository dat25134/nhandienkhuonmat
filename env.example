# Environment variables for Face Recognition API
# Copy this file to .env and update the values

# Flask settings
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database settings (if using external database)
# DATABASE_URL=sqlite:///data/db/app.db

# Face recognition settings
FACE_RECOGNITION_TOLERANCE=0.53
FACE_RECOGNITION_TOP2_GAP_MIN=0.07
BLUR_MIN_ENROLL=80.0
BLUR_MIN_QUERY=60.0

# Cache settings
CACHE_REBUILD_ON_STARTUP=true

# File upload settings
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes
